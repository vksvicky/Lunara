project.manifest = manifest.xml
base.sourcePath = source;test
base.resourcePath = resources

# Each round size has its own dial artwork. The size folder is first so
# dial_bg and the moon sprites come from that canvas, not a resized one.
fenix7s.resourcePath = resources-round-240x240;$(base.resourcePath)
fenix7spro.resourcePath = resources-round-240x240;$(base.resourcePath)

fenix7.resourcePath = resources-round-260x260;$(base.resourcePath)
